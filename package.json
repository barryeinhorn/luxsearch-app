{
  "name": "luxsearch-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon --watch server --ext ts --exec \"tsx server/src/index.ts\"",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^8.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "nodemon": "^3.0.4",
    "postcss": "^8.4.36",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.9.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.18",
    "@types/leaflet": "^1.9.5",
    "@types/node": "^20.14.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^2.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
